{
  "name": "fab-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo root: fab-cli (FAB CLI), fab-app (companion mobile app), pipeline (training/artifact pipeline)",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "gate": "bash scripts/gate.sh",
    "clean:vite-cache": "node scripts/clean-vite-cache.mjs",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "format:check": "pnpm -r --if-present run format:check",
    "test": "pnpm -r --if-present run test:run",
    "test:run": "pnpm -r --if-present run test:run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "build": "pnpm -r --if-present run build"
  },
  "op-sqlite": {
    "sqliteVec": true
  }
}
