{
  "name": "fab-app",
  "displayName": "FabApp",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "FAB companion app (React Native, iOS-first): on-device Q&A, card scanning, offline catalog. See ../SPEC-APP.md.",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:run": "jest",
    "gate": "npm run typecheck && npm run lint && npm run test:run"
  },
  "dependencies": {
    "@fab/manifest-schema": "workspace:*",
    "@op-engineering/op-sqlite": "^17.1.3",
    "@react-native/new-app-screen": "0.86.2",
    "i18next": "^26.3.6",
    "llama.rn": "^0.12.8",
    "react": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-vision-camera": "^5.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "op-sqlite": {
    "sqliteVec": true
  }
