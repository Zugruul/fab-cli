# React Native's autolinking (CLI, CocoaPods, Gradle) and several native
# modules' own install scripts (e.g. op-sqlite's podspec, which walks parent
# directories from node_modules looking for the app's package.json to read
# its "op-sqlite" config block — see fab-app/README.md "Monorepo + pnpm")
# assume a flat, npm-style node_modules they can walk with plain filesystem
# resolution. pnpm's default "isolated" linker uses a symlink farm into a
# central content-addressable store (.pnpm/) that those scripts don't
# understand.
#
# We tried scoping this to fab-app/.npmrc only (leaving fab-cli/pipeline on
# pnpm's default isolated linker) since fab-app is the only package with
# native RN dependencies — but pnpm computes node_modules layout for the
# whole workspace during a root-level `pnpm install` (the required install
# path — see fab-app/README.md), and a per-project .npmrc's node-linker is
# only honored when that project is installed on its own, so the per-project
# file was silently ignored on `pnpm install` from the repo root. It has to
# live here, at the workspace root, affecting all three packages.
#
# This still installs correctly for fab-cli and pipeline (hoisted just makes
# their node_modules flat/npm-style instead of symlinked — same declared
# dependencies, same resolution for code that doesn't reach for undeclared
# transitive deps); their gates were re-verified green after this change.
node-linker=hoisted
shamefully-hoist=true
